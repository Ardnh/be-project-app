# /etc/systemd/system/webhook-deploy.service

[Unit]
Description=Webhook Deployment Listener
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/deploy

# Environment
Environment="WEBHOOK_SECRET=your-super-secret-token"
Environment="DB_USER=myapp"
Environment="DB_NAME=myapp_db"
EnvironmentFile=/opt/myapp/.env

# Execution
ExecStart=/usr/bin/python3 /opt/deploy/webhook-server.py
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=0

# Resource limits
LimitNOFILE=65536
MemoryLimit=512M

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/logs /opt/myapp/backups

# Logging
StandardOutput=append:/opt/logs/webhook.log
StandardError=append:/opt/logs/webhook.log

[Install]
WantedBy=multi-user.target
